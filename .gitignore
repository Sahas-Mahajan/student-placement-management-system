bin/
*.class

# Third-party JAR binaries (downloaded via script / Maven)
lib/*.jar
!lib/.gitkeep

# IDE and Editor files
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# OS generated files
Thumbs.db
Desktop.ini
.DS_Store

# Logs and temporary files
*.log
